#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    require-prior-idle-ms = <200>;
};

&lt {
    tapping-term-ms = <300>;
    require-prior-idle-ms = <200>;
};

/ {
    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        us00_bq: us00_bq {
            compatible = "zmk,behavior-mod-morph";
            label = "US00_BQ";
            bindings = <&kp LS(LEFT_BRACKET)>, <&kp LS(EQUAL)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us01_min: us01_min {
            compatible = "zmk,behavior-mod-morph";
            label = "US01_MIN";
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us02_eq: us02_eq {
            compatible = "zmk,behavior-mod-morph";
            label = "US02_EQ";
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us03_se: us03_se {
            compatible = "zmk,behavior-mod-morph";
            label = "US03_SE";
            bindings = <&kp LS(APOS)>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us04_ap: us04_ap {
            compatible = "zmk,behavior-mod-morph";
            label = "US04_AP";
            bindings = <&kp LS(N2)>, <&kp LS(N7)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap { compatible = "zmk,keymap"; };
};

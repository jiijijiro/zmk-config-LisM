#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <200>;
};

&lt {
    tapping-term-ms = <300>;
    require-prior-idle-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        us_minus: us_minus {
            compatible = "zmk,behavior-mod-morph";
            label = "US_MINUS";
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_equal: us_equal {
            compatible = "zmk,behavior-mod-morph";
            label = "US_EQUAL";
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_semicolon: us_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "US_SEMICOLON";
            bindings = <&kp SEMI>, <&kp LS(N7)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_colon: us_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "US_COLON";
            bindings = <&kp APOS>, <&kp LS(N2)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap { compatible = "zmk,keymap"; };
};

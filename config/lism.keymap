            tapping-term-ms = <300>;
        };
    };

    macros {
        mc0: mc0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0 &mo 0>;
            label = "MC0";
        };

        mc1: mc1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1 &mo 0>;
            label = "MC1";
        };

        mc2: mc2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2 &mo 0>;
            label = "MC2";
        };

        mc3: mc3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3 &mo 0>;
            label = "MC3";
        };

        mc4: mc4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 4 &mo 0>;
            label = "MC4";
        };

        mc00: mc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG1 &kp LS(N8) &kp LS(N9) &kp LEFT>;

            label = "MC00";
        };

        mc01: mc01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N1 &kp LC(ENTER)>;

            label = "MC01";
        };

        mc02: mc02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N2 &kp LC(ENTER)>;

            label = "MC02";
        };

        mc03: mc03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N3 &kp LC(ENTER)>;

            label = "MC03";
        };

        mc04: mc04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp MINUS &kp LC(ENTER)>;

            label = "MC04";
        };

        mc05: mc05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp DOT &kp LC(ENTER)>;

            label = "MC05";
        };

        mc06: mc06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp T &kp ENTER>;

            label = "MC06";
        };

        mc07: mc07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp F &kp ENTER>;

            label = "MC07";
        };

        mc08: mc08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp V &kp ENTER>;

            label = "MC08";
        };

        mc09: mc09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp L>;

            label = "MC09";
        };

        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp C>;

            label = "MC10";
        };

        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp R>;

            label = "MC11";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 2 Q      &lt 1 W  &kp E       &kp R       &kp T                                        &trans       &kp Y        &kp U       &lt 1 I     &lt 2 O
&lt 1 A      &lt 2 S  &mt LALT D  &mt LGUI F  &mt LCTRL G                                  &trans       &mt RCTRL H  &mt RGUI J  &mt RALT K  &kp P
&mt LSHFT Z  &lt 6 X  &kp C       &kp V       &kp B                                        &TD03        &TD04        &kp N       &lt 6 L     &mt RSHFT L
&trans       &trans   &trans      &kp UP      &lt 2 LANG2  &lt 1 SPACE    &lt 2 BACKSPACE  &lt 1 LANG1  &trans       &trans      &trans      &trans
                      &kp LEFT    &kp DOWN    &kp RIGHT                                    &trans       &trans       &trans
            >;
        };

        layer_1 {
            bindings = <
&TD10   &mc01      &mc02           &mc03           &TD14                                         &kp HOME           &kp END    &kp N7  &kp N8  &lt 2 N9
&TD15   &TD16      &TD17           &TD18           &kp LC(PAGE_DOWN)                             &kp PG_UP          &kp PG_DN  &kp N4  &kp N5  &kp N6
&TD20   &kp LC(X)  &kp LC(C)       &TD23           &kp LC(B)                                     &TD08              &kp N0     &kp N1  &kp N2  &kp N3
&trans  &trans     &trans          &mmv MOVE_UP    &TD28              &TD29    &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &trans     &trans  &trans  &trans
                   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                               &trans             &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESC          &kp F1  &kp F2          &kp F3          &kp F4                                 &kp LC(T)         &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &mt LS(F5) LC(W)
&kp CAPS         &kp F5  &kp F6          &kp F7          &kp F8                                 &kp LA(LEFT)      &kp LEFT         &kp DOWN  &kp RIGHT    &kp F3
&kp PRINTSCREEN  &kp F9  &kp F10         &kp F11         &kp F12                                &kp LC(KP_MINUS)  &kp LC(KP_PLUS)  &kp F11   &trans       &trans
&trans           &trans  &trans          &msc SCRL_UP    &kp LG(L)        &kp LA(F4)    &trans  &trans            &trans           &trans    &trans       &trans
                         &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                        &trans            &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&lt 5 Q      &lt 4 W      &kp E       &kp R        &kp T                                        &trans       &kp Y       &kp U        &lt 4 I     &lt 5 O
&lt 4 A      &mt GLOBE S  &mt LALT D  &mt LCTRL F  &mt LGUI G                                   &trans       &mt RGUI H  &mt RCTRL J  &mt RALT K  &mt GLOBE P
&mt LSHFT Z  &lt 6 X      &kp C       &kp V        &kp B                                        &TD03        &TD04       &kp N        &lt 6 L     &mt RSHFT L
&trans       &trans       &trans      &kp UP       &lt 2 LANG2  &lt 1 SPACE    &lt 2 BACKSPACE  &lt 1 LANG1  &trans      &trans       &trans      &trans
                          &kp LEFT    &kp DOWN     &kp RIGHT                                    &trans       &trans      &trans
            >;
        };

        layer_4 {
            bindings = <
&trans     &trans     &trans          &trans          &trans                                      &kp HOME       &kp END    &kp N7  &kp N8  &lt 5 N9
&kp LG(A)  &kp LG(S)  &trans          &trans          &trans                                      &kp PG_UP      &kp PG_DN  &kp N4  &kp N5  &kp N6
&kp LG(Z)  &kp LG(X)  &kp LG(C)       &kp LG(V)       &kp LG(B)                                   &TD08          &kp N0     &kp N1  &kp N2  &kp N3
&trans     &trans     &trans          &mmv MOVE_UP    &kp LEFT         &kp RIGHT    &kp LG(LEFT)  &kp LG(RIGHT)  &trans     &trans  &trans  &trans
                      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                             &trans         &trans     &trans
            >;
        };

        layer_5 {
            bindings = <
&kt ESC         &kp F1  &kp F2          &kp F3          &kp F4                                &kp LG(T)              &kp LC(LS(TAB))  &kp UP    &kp LC(TAB)  &mt LG(R) LG(W)
&kp CAPS        &kp F5  &kp F6          &kp F7          &kp F8                                &kp LG(RIGHT_BRACKET)  &kp LEFT         &kp DOWN  &kp RIGHT    &kp F3
&kp LG(LS(N4))  &kp F9  &kp F10         &kp F11         &kp F12                               &kp LG(KP_MINUS)       &kp LG(KP_PLUS)  &trans    &trans       &trans
&trans          &trans  &trans          &msc SCRL_UP    &kp LG(LC(Q))    &kp LG(H)    &trans  &trans                 &trans           &trans    &trans       &trans
                        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                       &trans                 &trans           &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans        &trans        &trans                          &trans  &trans  &kp LS(N6)  &kp LS(N8)        &kp LS(N9)
&trans  &trans  &trans        &trans        &trans                          &trans  &trans  &kp LS(N4)  &kp LS(N5)        &kp EQUAL
&trans  &trans  &trans        &trans        &trans                          &TD08   &TD09   &kp LS(N1)  &kp LEFT_BRACKET  &kp LS(N3)
&trans  &trans  &trans        &kp C_VOL_UP  &trans        &trans    &trans  &trans  &trans  &trans      &trans            &trans
                &kp C_BRI_DN  &kp C_VOL_DN  &kp C_BRI_UP                    &trans  &trans  &trans
            >;
        };
    };
};

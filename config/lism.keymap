#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    require-prior-idle-ms = <200>;
};

&lt {
    tapping-term-ms = <300>;
    require-prior-idle-ms = <200>;
};

/ {
    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        us_bq: us_bq {
            compatible = "zmk,behavior-mod-morph";
            label = "US_BQ";
            bindings = <&kp LS(RIGHT_BRACKET)>, <&kp LS(EQUAL)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_min: us_min {
            compatible = "zmk,behavior-mod-morph";
            label = "US_MIN";
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_eq: us_eq {
            compatible = "zmk,behavior-mod-morph";
            label = "US_EQ";
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_se: us_se {
            compatible = "zmk,behavior-mod-morph";
            label = "US_SE";
            bindings = <&kp APOS>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_ap: us_ap {
            compatible = "zmk,behavior-mod-morph";
            label = "US_AP";
            bindings = <&kp LS(N2)>, <&kp LS(N7)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        TD00: TD00 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD00";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD02: TD02 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD02";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD03: TD03 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD03";
            #binding-cells = <0>;
            bindings = <&us_eq>, <&kp LS(APOS)>;

            tapping-term-ms = <300>;
        };

        TD04: TD04 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD04";
            #binding-cells = <0>;
            bindings = <&us_min>, <&kp LS(EQUAL)>;

            tapping-term-ms = <300>;
        };

        TD05: TD05 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD05";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD06: TD06 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD06";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD07: TD07 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD07";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD08: TD08 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD08";
            #binding-cells = <0>;
            bindings = <&kp KP_PLUS>, <&kp KP_ASTERISK>;

            tapping-term-ms = <300>;
        };

        TD09: TD09 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD09";
            #binding-cells = <0>;
            bindings = <&kp KP_MINUS>, <&kp KP_SLASH>;

            tapping-term-ms = <300>;
        };

        TD10: TD10 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD10";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD11: TD11 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD11";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD12: TD12 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD12";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD13: TD13 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD13";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD14: TD14 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD14";
            #binding-cells = <0>;
            bindings = <&mc05>, <&mc06>;

            tapping-term-ms = <300>;
        };

        TD15: TD15 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD15";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>, <&mc09>;

            tapping-term-ms = <300>;
        };

        TD16: TD16 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD16";
            #binding-cells = <0>;
            bindings = <&kp LC(S)>, <&mc10>;

            tapping-term-ms = <300>;
        };

        TD17: TD17 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD17";
            #binding-cells = <0>;
            bindings = <&none>, <&mc11>;

            tapping-term-ms = <300>;
        };

        TD18: TD18 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD18";
            #binding-cells = <0>;
            bindings = <&kp LC(PAGE_UP)>, <&mc07>;

            tapping-term-ms = <300>;
        };

        TD19: TD19 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD19";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD20: TD20 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD20";
            #binding-cells = <0>;
            bindings = <&mt LC(LSHFT) LC(Z)>, <&kp LC(N1)>;

            tapping-term-ms = <300>;
        };

        TD21: TD21 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD21";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD22: TD22 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD22";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD23: TD23 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD23";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>, <&mc08>;

            tapping-term-ms = <300>;
        };

        TD24: TD24 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD24";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD25: TD25 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD25";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD26: TD26 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD26";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD27: TD27 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD27";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD28: TD28 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD28";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(LEFT))>, <&kp LA(LC(LG(LEFT)))>;

            tapping-term-ms = <300>;
        };

        TD29: TD29 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD29";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(RIGHT))>, <&kp LA(LC(LG(RIGHT)))>;

            tapping-term-ms = <300>;
        };

        TD30: TD30 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD30";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD31: TD31 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD31";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD000: TD000 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD000";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD001: TD001 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD001";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD002: TD002 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD002";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD003: TD003 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD003";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD004: TD004 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD004";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };
    };

    macros {
        mc00: mc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "MC00";
        };

        mc01: mc01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N1 &kp LC(ENTER)>;

            label = "MC01";
        };

        mc02: mc02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N2 &kp LC(ENTER)>;

            label = "MC02";
        };

        mc03: mc03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N3 &kp LC(ENTER)>;

            label = "MC03";
        };

        mc04: mc04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp MINUS &kp LC(ENTER)>;

            label = "MC04";
        };

        mc05: mc05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp DOT &kp LC(ENTER)>;

            label = "MC05";
        };

        mc06: mc06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp T &kp ENTER>;

            label = "MC06";
        };

        mc07: mc07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp F &kp ENTER>;

            label = "MC07";
        };

        mc08: mc08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp V &kp ENTER>;

            label = "MC08";
        };

        mc09: mc09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp L>;
            label = "MC09";
        };

        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp C>;
            label = "MC10";
        };

        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp R>;
            label = "MC11";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo00 {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo01 {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        combo02 {
            bindings = <&mo 3>;
            key-positions = <20 21>;
        };

        combo03 {
            bindings = <&kp LANG2>;
            key-positions = <34 35>;
        };

        combo04 {
            bindings = <&us_bq>;
            key-positions = <5 6>;
        };

        combo05 {
            bindings = <&mc00>;
            key-positions = <6 7>;
        };

        combo06 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
        };

        combo07 {
            bindings = <&kp NON_US_HASH>;
            key-positions = <8 9>;
        };

        combo08 {
            bindings = <&us_ap>;
            key-positions = <16 17>;
        };

        combo09 {
            bindings = <&us_se>;
            key-positions = <17 18>;
        };

        combo10 {
            bindings = <&kp INT3>;
            key-positions = <18 19>;
        };

        combo11 {
            bindings = <&kp COMMA>;
            key-positions = <26 27>;
        };

        combo12 {
            bindings = <&kp DOT>;
            key-positions = <27 28>;
        };

        combo13 {
            bindings = <&kp SLASH>;
            key-positions = <28 29>;
        };

        combo14 {
            bindings = <&kp LANG1>;
            key-positions = <36 37>;
        };

        combo15 {
            bindings = <&kp DEL>;
            key-positions = <0 10>;
        };

        combo16 {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 20>;
        };

        combo17 {
            bindings = <&mkp MB1>;
            key-positions = <1 11>;
        };

        combo18 {
            bindings = <&mkp MB2>;
            key-positions = <2 12>;
        };

        combo19 {
            bindings = <&kp PAGE_UP>;
            key-positions = <3 13>;
        };

        combo20 {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <4 14>;
        };

        combo21 {
            bindings = <&kp HOME>;
            key-positions = <3 4>;
        };

        combo22 {
            bindings = <&kp END>;
            key-positions = <13 14>;
        };

        combo23 {
            bindings = <&kp UP>;
            key-positions = <12 13>;
        };

        combo24 {
            bindings = <&kp DOWN>;
            key-positions = <22 23>;
        };

        combo25 {
            bindings = <&kp LEFT>;
            key-positions = <12 22>;
        };

        combo26 {
            bindings = <&kp RIGHT>;
            key-positions = <13 23>;
        };

        combo27 {
            bindings = <&mkp MB1>;
            key-positions = <7 17>;
        };

        combo28 {
            bindings = <&mkp MB2>;
            key-positions = <8 18>;
        };

        combo29 {
            bindings = <&kp DEL>;
            key-positions = <9 19>;
        };

        combo30 {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 29>;
        };

        combo31 {
            bindings = <&bootloader>;
            key-positions = <20 30>;
            layers = <3>;
        };

        combo32 {
            bindings = <&bootloader>;
            key-positions = <29 41>;
            layers = <3>;
        };

        combo33 {
            bindings = <&bt BT_CLR>;
            key-positions = <41 40>;
            layers = <3>;
        };

        combo34 {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <41 40 39>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 3 Q      &lt 2 W      &lt 1 E         &kp R           &kp T                                      &trans           &kp Y       &kp U        &kp I       &lt 3 O
&kp A        &mt LSHFT S  &mt LALT D      &mt LCTRL F     &mt LGUI G                                 &trans           &mt RGUI H  &mt RCTRL J  &mt RALT K  &mt RSHFT P
&mt LSHFT Z  &lt 3 X      &kp C           &kp V           &kp B                                      &TD03            &TD04       &kp N        &kp M       &mt RSHFT L
&trans       &trans       &trans          &mmv MOVE_UP    &lt 2 ENTER      &lt 1 SPACE    &lt 1 TAB  &lt 2 BACKSPACE  &trans      &trans       &trans      &trans
                          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                            &trans           &trans      &trans
            >;

            sensor-bindings = <&encoder_kp LEFT RIGHT>;
        };

        layer_1 {
            bindings = <
&mc01   &mc02      &mc03         &mc04         &TD14                                    &trans         &kp N7  &kp N8  &kp N9  &kp N0
&TD15   &TD16      &TD17         &TD18         &kp LC(PAGE_DOWN)                        &TD09          &kp N4  &kp N5  &kp N6  &kp DOT
&TD20   &kp LC(X)  &kp LC(C)     &TD23         &kp LC(B)                                &TD08          &kp N1  &kp N2  &kp N3  &kp ENTER
&trans  &trans     &trans        &kp C_VOL_UP  &kp ENTER          &kp SPACE    &kp TAB  &kp BACKSPACE  &trans  &trans  &trans  &trans
                   &kp C_BRI_DN  &kp C_VOL_DN  &kt C_BRI_UP                             &trans         &trans  &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_LEFT SCRL_RIGHT>;
        };

        layer_2 {
            bindings = <
&mt F1 LA(LC(TAB))  &kp F2   &kp F3            &kp F4             &kp F5                                            &kp LC(T)          &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)       &kp LS(LC(W))
&kp F6              &kp F7   &kp F8            &kp F9             &kp F10                                           &kp LA(LEFT)       &kp LEFT         &kp DOWN  &kp RIGHT         &kp LS(F5)
&kp F11             &kp F12  &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &mt LG(P) PRINTSCREEN                             &kp F11            &TD28            &TD29     &kp LC(KP_MINUS)  &kp LC(KP_PLUS)
&trans              &trans   &trans            &kp UP             &TD28                  &TD29    &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &trans           &trans    &trans            &trans
                             &kp LEFT          &kp DOWN           &kp RIGHT                                         &trans             &trans           &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_3 {
            bindings = <
&out OUT_USB  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3                               &trans           &kp LS(N6)  &kp LS(APOS)      &kp LS(N8)  &kp LS(N9)
&trans        &trans        &trans          &trans          &trans                                     &trans           &kp LS(N4)  &kp LS(N5)        &kp EQUAL   &trans
&trans        &trans        &trans          &trans          &trans                                     &trans           &kp LS(N1)  &kp LEFT_BRACKET  &kp LS(N3)  &trans
&trans        &trans        &trans          &msc SCRL_UP    &mt LG(L) LG(D)  &kp LA(F4)    &kp LA(F4)  &mt LG(L) LG(D)  &trans      &trans            &trans      &trans
                            &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                            &trans           &trans      &trans
            >;

            sensor-bindings = <&encoder_kp UP DOWN>;
        };
    };
};
